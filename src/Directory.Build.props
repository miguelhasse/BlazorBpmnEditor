<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shipping code: warnings are errors, XML docs required, packable. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.esproj'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors></WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <VersionPrefix>2.0.0</VersionPrefix>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BpmnCompatibilityAnalysis)' == 'true' and '$(MSBuildProjectExtension)' == '.csproj' and '$(MSBuildProjectName)' != 'Hasseware.AspNetCore.Components.Bpmn.RulesGenerator'">
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.esproj'">
    <None Include="$(RepositoryRoot)LICENSE.txt" Link="LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
