{
  "name": "hasseware.aspnetcore.components.bpmn.feelsharp.assets",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && node esbuild.config.mjs",
    "test": "npm run build && node --test test/editor.test.mjs",
