@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn.FeelSharp
@using Hasseware.AspNetCore.Components.Bpmn.Editing
@inherits BpmnFeelSharpEditorBase
@{
    var generation = _generation;
}

<div class="fluent-bpmn-feelsharp @(Block + "__feel-entry")">
    @if (Entry.Feel == BpmnFeelMode.Optional)
    {
        <FluentButton Type="ButtonType.Button" Class="@(Block + "__feel-toggle")"
                      aria-label="@Text("PropertyEntry.ToggleFeel")" aria-pressed="@(FeelActive ? "true" : "false")"
                      Disabled="@ReadOnly" OnClick="ToggleAsync">@Text("Expression.Function")</FluentButton>
    }
    @if (FeelActive || ReadOnly)
    {
        <FluentLabel ForId="@InputId" title="@Entry.Tooltip">@Entry.Label</FluentLabel>
        <div class="fluent-bpmn-feelsharp-control">
            @if (FeelActive)
            {
                <span class="@(Block + "__feel-badge")">@Text("Expression.Feel")</span>
            }
            <div class="fluent-bpmn-feelsharp-surface" @ref="_surface"
                 data-enhanced="@(_enhanced ? "true" : "false")" data-generation="@_generation"
                 data-completion="@(_completions.Count > 0 ? "true" : "false")"
                 data-input-label="@Entry.Label" data-input-invalid="@(Entry.Error is not null || Warning is not null ? "true" : null)"
                 data-input-describedby="@DescribedBy" data-input-autocomplete="list" data-input-controls="@CompletionId"
                 data-input-expanded="@(_completions.Count > 0 ? "true" : "false")"
                 data-input-activedescendant="@(_completions.Count > 0 ? OptionId(_selected) : null)">
                <FluentFeelSharpInput Id="@InputId" @ref="_textArea" @key="_generation"
                                     Height="@(FormattableString.Invariant($"{MultilineRows * 1.5 + 1}em"))"
                                     InitialValue="@(_enhanced ? _initialText : DisplayValue)"
                                     ValueChanged="value => DraftChanged(value, generation)"
                                     Enhanced="@_enhanced" DescribedBy="@DescribedBy"
                                     AriaInvalid="@(Entry.Error is not null || Warning is not null ? "true" : null)"
                                     IsReadOnly="@ReadOnly" Placeholder="@Entry.Placeholder" Label="@Entry.Label"
                                     FocusOut="args => CommitFallbackAsync(args, generation)"
                                     KeyDown="args => KeyDownAsync(args, generation)" />
                <pre class="bpmn-feelsharp-highlight" aria-hidden="true">@foreach (var token in FeelSharpLanguage.Tokenize(DisplayValue))
                    {<span class="@("feel-" + token.Kind)">@token.Text</span>}@("\n")</pre>
            </div>
            @if (_completions.Count > 0 && !ReadOnly)
            {
                <div id="@CompletionId" class="fluent-bpmn-feelsharp-completions" role="listbox"
                     aria-label="@Entry.Label" @onmousedown:preventDefault>
                    @for (var index = 0; index < _completions.Count; index++)
                    {
                        var option = index;
                        var completion = _completions[index];
                        <FluentButton Id="@OptionId(index)" Type="ButtonType.Button" Appearance="ButtonAppearance.Transparent"
                                      role="option" aria-selected="@(index == _selected ? "true" : "false")"
                                      tabindex="-1" OnClick="() => ApplyCompletionAsync(option)">
                            @completion.Label
                            @if (completion.Detail is not null)
                            {
                                <small>@completion.Detail</small>
                            }
                        </FluentButton>
                    }
                </div>
            }
            @if (Warning is { } warning)
            {
                <FluentMessageBar Id="@WarningId" Intent="MessageBarIntent.Warning" AllowDismiss="false" role="status">@warning</FluentMessageBar>
            }
        </div>
        @if (Entry.Description is { Length: > 0 })
        {
            <span class="@(Block + "__description")">@Entry.Description</span>
        }
        @if (Entry.Error is { Length: > 0 })
        {
            <FluentMessageBar Id="@ErrorId" Intent="MessageBarIntent.Error" AllowDismiss="false" role="alert">@Entry.Error</FluentMessageBar>
        }
    }
    else
    {
        <DynamicComponent Type="@DefaultEditor" Parameters="@EditorParameters" @key="Context.Revision" />
    }
</div>
