<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hasseware.AspNetCore.Components.Bpmn.Storage.AzureBlob</AssemblyName>
    <RootNamespace>Hasseware.AspNetCore.Components.Bpmn.Storage.AzureBlob</RootNamespace>
    <PackageId>Hasseware.AspNetCore.Components.Bpmn.Storage.AzureBlob</PackageId>
    <Description>Preview. A BPMN document store over an Azure Blob Storage container: the blob's ETag is the revision, every write is conditional, and the container, prefix and credentials stay in host configuration.</Description>
    <PackageTags>bpmn;storage;azure;blob</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bpmn\Hasseware.AspNetCore.Components.Bpmn.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
