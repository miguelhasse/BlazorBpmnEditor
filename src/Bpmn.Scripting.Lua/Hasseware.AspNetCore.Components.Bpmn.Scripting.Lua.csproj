<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hasseware.AspNetCore.Components.Bpmn.Scripting.Lua</AssemblyName>
    <RootNamespace>Hasseware.AspNetCore.Components.Bpmn.Scripting.Lua</RootNamespace>
    <PackageId>Hasseware.AspNetCore.Components.Bpmn.Scripting.Lua</PackageId>
    <Description>Lua script syntax validation for Script Tasks in Hasseware Blazor BPMN components.</Description>
    <PackageTags>bpmn;blazor;script;lua;validation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bpmn\Hasseware.AspNetCore.Components.Bpmn.csproj" />
    <PackageReference Include="Loretta.CodeAnalysis.Lua" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
