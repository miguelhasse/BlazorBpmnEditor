@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn
@inherits BpmnContextMenuBase
@using Hasseware.AspNetCore.Components.Bpmn.Editing

@if (IsOpen)
{
    <div class="@CssClass("bpmn-menu")"
         role="menu"
         tabindex="-1"
         aria-label="@EffectiveAriaLabel"
         data-bpmn-element="@Selected?.ElementId"
         style="@PositionStyle"
         @ref="FocusTarget"
         @onkeydown="HandleKeyDownAsync"
         @onkeydown:stopPropagation="true"
         @attributes="AdditionalAttributes">

        <p class="bpmn-menu__title">@Title</p>

        @if (Selected is { Diagnostics.Count: > 0 } diagnosed)
        {
            <ul class="bpmn-menu__diagnostics" aria-label="@FindingsLabel">
                @foreach (var diagnostic in diagnosed.Diagnostics)
                {
                    <li class="bpmn-menu__diagnostic" @key="diagnostic.Code">
                        <span class="bpmn-menu__code">@diagnostic.Code</span> @diagnostic.Message
                    </li>
                }
            </ul>
        }

        @if (Entries.Count > 0)
        {
            <div class="bpmn-menu__group bpmn-menu__commands" role="group" aria-label="@CommandsLabel">
                @foreach (var command in Entries)
                {
                    <FluentButton Type="ButtonType.Button"
                                  Class="bpmn-menu__item"
                                  role="menuitem"
                                  Title="@LabelFor(command)"
                                  aria-label="@LabelFor(command)"
                                  IconStart="@CommandIcon(command.Command)"
                                  IconOnly="true"
                                  @key="command.Command"
                                  Disabled="@(!command.IsEnabled)"
                                  OnClick="@(() => InvokeAsync(command.Command))" />
                }
            </div>
        }
        else
        {

            <p class="bpmn-menu__empty" role="menuitem" aria-disabled="true">@EmptyMessage</p>
        }

        @if (Selected is { SwitchableTypes.Count: > 1 } switchable && switchable.Capabilities.CanSwitchType)
        {
            <div class="bpmn-menu__group" role="group" aria-label="@SwitchTypeLabel">
                <FluentSelect TOption="BpmnTypeOption" TValue="string"
                              Class="bpmn-menu__type-select"
                              @key="(switchable.ElementId, TypeRevision)"
                              Label="@SwitchTypeLabel" AriaLabel="@SwitchTypeLabel"
                              Items="@switchable.SwitchableTypes"
                              OptionValue="@TypeValue" OptionText="@Display.TypeOption"
                              Value="@SelectedTypeValue" ValueChanged="@SelectTypeAsync" />
            </div>
        }

        @if (Selected is { Properties.Count: > 0 } described)
        {

            <div class="bpmn-menu__group">
                <p class="bpmn-menu__heading">@PropertiesLabel</p>

                <FluentBpmnPropertyForm Properties="@described.Properties"
                                        Revision="@Revision"
                                        OnEdit="@SetAsync" />
            </div>
        }

    </div>
}
