@inject Microsoft.Extensions.Localization.IStringLocalizer<Hasseware.FluentUI.AspNetCore.Components.Bpmn.Resources.FluentBpmnEditorStrings> EditorL
@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn
@inherits BpmnAgentConfirmationBase

<FluentBpmnDialog Visible="@(Request is not null)" Class="@CssClass("bpmn-confirm")" OnDismiss="DenyAsync" role="alertdialog" aria-modal="true" aria-label="@EffectiveAriaLabel" @attributes="AdditionalAttributes">
    <TitleTemplate>
        @if (Request is { } request)
        {
            <h2 class="bpmn-confirm__title">@request.Title</h2>
        }
    </TitleTemplate>
    <ChildContent>
    @if (Request is { } request)
    {
        <div class="bpmn-confirm__panel @(request.IsDestructive ? "bpmn-confirm__panel--destructive" : null)">
            <p class="bpmn-confirm__origin">@EditorText("AgentConfirmation.RequestedBy", AgentName)</p>
            <p class="bpmn-confirm__summary">@request.Summary</p>

            @if (request.Details.Count > 0)
            {
                <ul class="bpmn-confirm__details" aria-label="@EditorText("AgentConfirmation.Details")">
                    @foreach (var detail in request.Details)
                    {
                        <li>@detail</li>
                    }
                </ul>
            }

        </div>
    }
    </ChildContent>
    <ActionTemplate>
        <div class="bpmn-confirm__actions @(Request?.IsDestructive == true ? "bpmn-confirm__panel--destructive" : null)">
            <FluentButton Type="ButtonType.Button" IconStart="@(new Icons.Regular.Size20.Dismiss())" Class="bpmn-confirm__deny" OnClick="DenyAsync">
                @EditorText("AgentConfirmation.Deny")
            </FluentButton>
            <FluentButton Type="ButtonType.Button" Class="bpmn-confirm__allow" OnClick="AllowAsync">
                @EditorText("AgentConfirmation.Allow")
            </FluentButton>
        </div>
    </ActionTemplate>
</FluentBpmnDialog>
