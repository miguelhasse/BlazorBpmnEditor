@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn
@inherits BpmnShortcutHelpBase

@if (IsVisible)
{
    <FluentBpmnDialog Class="@CssClass("bpmn-shortcut-help")" OnDismiss="CloseAsync" role="dialog" aria-modal="true" aria-labelledby="@($"{Id}-title")" @attributes="AdditionalAttributes">

        <div class="bpmn-shortcut-help__panel" @onkeydown="HandleKeyDownAsync" @onkeydown:stopPropagation="true"
>
            <h2 class="bpmn-shortcut-help__title" id="@($"{Id}-title")">@EffectiveTitle</h2>

            @if (Groups.Count == 0)
            {
                <p class="bpmn-shortcut-help__empty">@EmptyMessage</p>
            }
            else
            {
                <dl class="bpmn-shortcut-help__list">
                    @foreach (var group in Groups)
                    {
                        <div class="bpmn-shortcut-help__row">
                            <dt>
                                @foreach (var (keys, index) in group.Keys.Select((k, i) => (k, i)))
                                {
                                    @if (index > 0)
                                    {
                                        <span class="bpmn-shortcut-help__or"> @OrText </span>
                                    }
                                    <kbd>@keys</kbd>
                                }
                            </dt>
                            <dd>@group.Description</dd>
                        </div>
                    }
                </dl>
            }

            <FluentButton Type="ButtonType.Button"
                    Class="bpmn-shortcut-help__close" AutoFocus="true"
                    @ref="_close" IconStart="@(new Icons.Regular.Size20.Dismiss())"
                    OnClick="CloseAsync">@CloseText</FluentButton>
        </div>
    </FluentBpmnDialog>
}
