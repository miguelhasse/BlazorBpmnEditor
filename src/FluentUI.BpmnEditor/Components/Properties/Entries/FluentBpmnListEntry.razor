@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn
@inherits BpmnPropertyEntryComponent
@using Hasseware.AspNetCore.Components.Bpmn.Editing
@using Hasseware.AspNetCore.Components.Bpmn.Validation

<div class="@(Block + "__property " + Block + "__list")" title="@Entry.Tooltip">
    <table class="@(Block + "__table")" aria-label="@Entry.Label">
        <thead><tr>
            @foreach (var column in VisibleColumns)
            {
                <th scope="col">@column.Label</th>
            }
            @if (!ReadOnly) { <th scope="col">@EditorL["ListEntry.Actions"]</th> }
        </tr></thead>
        <tbody>
            @for (var index = 0; index < _rows.Count; index++)
            {
                var rowIndex = index;
                <tr>
                    @foreach (var column in VisibleColumns)
                    {
                        <td>
                            @if (column.Feel is BpmnFeelMode.Required or BpmnFeelMode.Optional || column.ExpressionLanguage != BpmnExpressionLanguage.None)
                            {
                                <FluentBpmnPropertyEntryView Context="@CellContext(rowIndex, column)" />
                            }
                            else
                            {
                                <FluentTextInput Class="@(Block + "__text")" ReadOnly="@ReadOnly"
                                                 Value="@_rows[rowIndex].GetValueOrDefault(column.Name)" Placeholder="@Entry.Placeholder"
                                                 AriaLabel="@EditorL["ListEntry.CellLabel", column.Label, rowIndex + 1].Value"
                                                 ValueChanged="@(value => ChangeCellAsync(rowIndex, column.Name, value))" />
                            }
                        </td>
                    }
                    @if (!ReadOnly)
                    {
                        <td class="@(Block + "__row-actions")">
                            <FluentButton Type="ButtonType.Button" aria-label="@EditorL["ListEntry.RemoveLabel", rowIndex + 1]" IconStart="@(new Icons.Regular.Size20.Delete())" Tooltip="@EditorL["ListEntry.Remove", rowIndex + 1]" IconOnly="true" OnClick="@(() => RemoveAsync(rowIndex))" />
                            <FluentButton Type="ButtonType.Button" aria-label="@EditorL["ListEntry.MoveUp", rowIndex + 1]" Disabled="@(rowIndex == 0)" IconStart="@(new Icons.Regular.Size20.ArrowUp())" IconOnly="true" OnClick="@(() => MoveAsync(rowIndex, -1))" />
                            <FluentButton Type="ButtonType.Button" aria-label="@EditorL["ListEntry.MoveDown", rowIndex + 1]" Disabled="@(rowIndex == _rows.Count - 1)" IconStart="@(new Icons.Regular.Size20.ArrowDown())" IconOnly="true" OnClick="@(() => MoveAsync(rowIndex, 1))" />
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    @if (!ReadOnly) { <FluentButton Type="ButtonType.Button" Class="@(Block + "__add-row")" IconStart="@(new Icons.Regular.Size20.Add())" OnClick="AddAsync">@EditorL["ListEntry.Add"]</FluentButton> }
    <FluentBpmnPropertyEntryHelp Context="@Context" />
</div>
