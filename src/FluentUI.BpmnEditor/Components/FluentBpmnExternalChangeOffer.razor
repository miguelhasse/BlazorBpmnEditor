@inject Microsoft.Extensions.Localization.IStringLocalizer<Hasseware.FluentUI.AspNetCore.Components.Bpmn.Resources.FluentBpmnEditorStrings> EditorL
@namespace Hasseware.FluentUI.AspNetCore.Components.Bpmn
@inherits BpmnExternalChangeOfferBase

@if (HasNotice)
{
    <div class="@CssClass("bpmn-change")" role="alert" aria-label="@EffectiveAriaLabel" @attributes="AdditionalAttributes">
        @if (IsConfirmingReload)
        {
            <FluentMessageBar Class="bpmn-change__message" AllowDismiss="false" Intent="MessageBarIntent.Warning">@EditorText("ExternalChangeOffer.ConfirmReload")</FluentMessageBar>

            <div class="bpmn-change__actions">
                <FluentButton Type="ButtonType.Button" Class="bpmn-change__action" Disabled="@IsBusy" OnClick="CancelReload">
                    @EditorText("ExternalChangeOffer.KeepEditing")
                </FluentButton>
                <FluentButton Type="ButtonType.Button" Class="bpmn-change__action bpmn-change__action--primary" Disabled="@IsBusy" OnClick="ConfirmReloadAsync">
                    @EditorText("ExternalChangeOffer.DiscardAndReload")
                </FluentButton>
            </div>
        }
        else
        {
            @if (Outcome is not null)
            {
                <FluentMessageBar Class="bpmn-change__message" AllowDismiss="false" Intent="@(OutcomeIsFailure ? MessageBarIntent.Error : MessageBarIntent.Success)">@Outcome</FluentMessageBar>
            }

            @if (Change is not null)
            {
                <FluentMessageBar Class="bpmn-change__message" AllowDismiss="false" Intent="@(IsDeleted ? MessageBarIntent.Error : MessageBarIntent.Warning)">@Message</FluentMessageBar>
            }

            <div class="bpmn-change__actions">
                <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Dismiss())" Class="bpmn-change__action" Disabled="@IsBusy" OnClick="Dismiss">
                    @EditorText("ExternalChangeOffer.Dismiss")
                </FluentButton>

                @if (IsDeleted)
                {
                    <FluentButton Type="ButtonType.Button" Class="bpmn-change__action bpmn-change__action--primary" Disabled="@IsBusy" OnClick="SaveAgainAsync">
                        @EditorText("ExternalChangeOffer.SaveAgain")
                    </FluentButton>
                }
                else if (Change is not null)
                {
                    <FluentButton Type="ButtonType.Button" Class="bpmn-change__action" Disabled="@IsBusy" OnClick="SaveCopyAsync">
                        @EditorText("ExternalChangeOffer.SaveCopy")
                    </FluentButton>
                    <FluentButton Type="ButtonType.Button" Class="bpmn-change__action bpmn-change__action--primary" Disabled="@IsBusy" OnClick="ReloadAsync">
                        @EditorText("ExternalChangeOffer.Reload")
                    </FluentButton>
                }
            </div>
        }
    </div>
}
