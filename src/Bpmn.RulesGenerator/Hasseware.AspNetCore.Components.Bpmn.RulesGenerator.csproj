<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;IsAotCompatible;IsTrimmable;SelfContained;RuntimeIdentifier">

  <PropertyGroup>
    <!-- Source generators load into whatever Roslyn version the consuming SDK ships, so this
         targets netstandard2.0 for the broadest possible host compatibility rather than the
         repo's usual net10.0 (a Roslyn-authoring convention, not an accident). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- A generator executes in the build host, never in the published application. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier />
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- This project has exactly one internal diagnostic (a malformed-rule-table error) with no
         public analyzer release process — release-tracking (RS2008) doesn't apply here. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
