@namespace Hasseware.AspNetCore.Components.Bpmn

<BpmnPropertyScopeProvider Block="@Block" MultilineRows="@MultilineRows">
    <div class="@CssClass" role="group" aria-label="@EffectiveLabel">
        @foreach (var property in Properties)
        {
            <BpmnPropertyEntryView Context="@BuildContext(property)" />
        }
    </div>
</BpmnPropertyScopeProvider>
