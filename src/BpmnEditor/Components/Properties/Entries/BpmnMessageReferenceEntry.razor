@namespace Hasseware.AspNetCore.Components.Bpmn
@inherits BpmnMessageReferenceEntryComponent

<BpmnPropertyEntryFrame Context="@Context">
    <div @ref="FocusTarget" tabindex="-1" class="bpmn-message-reference">
        <select class="@(Block + "__select")" disabled="@ReadOnly" aria-label="@Entry.Label"
                aria-invalid="@(Entry.Error is not null ? "true" : null)"
                @onchange="@(args => SubmitAsync(args.Value as string))">
            @foreach (var choice in MessageChoices)
            {
                <option value="@choice.Value" selected="@(choice.Value == (Entry.Value ?? string.Empty))">@choice.Label</option>
            }
        </select>
        @if (!HasMessages) { <p>@Text("MessageCatalog.Empty")</p> }
        @if (CanAuthor)
        {
            <div class="bpmn-message-reference__actions">
                @if (!ReadOnly)
                {
                    <button type="button" data-message-action="new" @onclick="NewMessage">@Text("MessageCatalog.New")</button>
                    <button type="button" data-message-action="edit" disabled="@(!CanEditMessage)" @onclick="EditMessage">@Text("MessageCatalog.EditShared")</button>
                }
                <button type="button" data-message-action="manage" @onclick="ManageMessages">@Text("MessageCatalog.Manage")</button>
            </div>
        }
    </div>
</BpmnPropertyEntryFrame>
