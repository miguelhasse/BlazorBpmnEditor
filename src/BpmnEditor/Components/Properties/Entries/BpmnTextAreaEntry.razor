@namespace Hasseware.AspNetCore.Components.Bpmn
@inherits BpmnPropertyEntryComponent

<BpmnPropertyEntryFrame Context="@ValidationContext">
    <textarea class="@(Block + "__text " + Block + "__text--multiline")" rows="@MultilineRows"
              readonly="@ReadOnly" value="@_value" placeholder="@Entry.Placeholder"
              aria-invalid="@(ValidationContext.Entry.Error is not null ? "true" : null)"
              aria-describedby="@(ValidationContext.Entry.Error is not null ? ErrorId : null)"
              @oninput="Input" @onchange="ChangeAsync"></textarea>
</BpmnPropertyEntryFrame>
