<Project>
  <PropertyGroup>
    <_ParentDirectoryBuildTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)..\'))</_ParentDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="$(_ParentDirectoryBuildTargets)" Condition="'$(_ParentDirectoryBuildTargets)' != ''" />

  <PropertyGroup>
    <EnableXlfLocalization Condition="'$(EnableXlfLocalization)' == ''">false</EnableXlfLocalization>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.esproj' and '$(EnableXlfLocalization)' == 'true'">
    <PackageReference Include="Microsoft.DotNet.XliffTasks" PrivateAssets="all" />
  </ItemGroup>

  <!-- Solution-level dotnet pack visits .esproj projects even though the JavaScript SDK has no Pack target. -->
  <Target Name="Pack" Condition="'$(MSBuildProjectExtension)' == '.esproj'">
    <Message Importance="Low" Text="Skipping NuGet packing for non-packable JavaScript project $(MSBuildProjectName)." />
  </Target>
</Project>
