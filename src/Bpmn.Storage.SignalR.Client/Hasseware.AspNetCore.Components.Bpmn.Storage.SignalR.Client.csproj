<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hasseware.AspNetCore.Components.Bpmn.Storage.SignalR.Client</AssemblyName>
    <RootNamespace>Hasseware.AspNetCore.Components.Bpmn.Storage.SignalR.Client</RootNamespace>
    <PackageId>Hasseware.AspNetCore.Components.Bpmn.Storage.SignalR.Client</PackageId>
    <Description>Preview. The client of the BPMN SignalR change feed, for Blazor WebAssembly and any .NET client: reconnects with backoff and tells the editor after every gap.</Description>
    <PackageTags>bpmn;storage;signalr;live-updates;webassembly</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Bpmn\Hasseware.AspNetCore.Components.Bpmn.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
