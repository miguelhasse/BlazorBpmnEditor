%% Project dependencies
%% Solid arrows: dependent → referenced project. Dashed arrows: shared input / produced assets.
%% Bpmn references Scripts privately and RulesGenerator as Analyzer (ReferenceOutputAssembly=false).
%% WebMcp references Bpmn + Tools + WebMcp.Scripts privately.
%% Feel references Bpmn + Feel.Scripts privately. Icons manifest is embedded in Bpmn and imported by TypeScript.
flowchart TB
    feel["Bpmn.Feel<br/>src/Bpmn.Feel<br/>Optional FEEL component"]:::cs
    tools["Bpmn.Tools<br/>src/Bpmn.Tools<br/>Agent tool handlers (preview)"]:::cs
    webmcp["Bpmn.WebMcp<br/>src/Bpmn.WebMcp<br/>Browser agent tools (preview)"]:::cs
    wscripts["Bpmn.WebMcp.Scripts<br/>src/Bpmn.WebMcp.Scripts<br/>JavaScript SDK .esproj"]:::js
    webmcptests["Bpmn.WebMcp.Tests<br/>tests/Bpmn.WebMcp.Tests"]:::test
    core["Bpmn<br/>src/Bpmn<br/>Canvas, model, behavior, localization<br/>No Fluent UI dependency"]:::cs
    standard["BpmnEditor<br/>Standard Blazor UI kit<br/>No Fluent UI dependency"]:::cs
    fluent["FluentUI.BpmnEditor<br/>Fluent UI composition<br/>Components + Icons packages"]:::cs
    scripts["Bpmn.Scripts<br/>src/Bpmn.Scripts<br/>JavaScript SDK .esproj"]:::js
    assets["Static web assets<br/>Core + optional FEEL and WebMCP bundles"]:::data
