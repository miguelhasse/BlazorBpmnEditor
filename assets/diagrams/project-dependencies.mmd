    icons["icons/<br/>Shared glyph manifest"]:::data
    client["Bpmn.Demo.Client<br/>playground/Bpmn.Demo.Client"]:::cs
    demo["Bpmn.Demo<br/>playground/Bpmn.Demo<br/>Server host"]:::cs
    tests["Bpmn.Tests + editor test projects<br/>Core, standard, Fluent<br/>Shared behavior + architecture tests"]:::test
    bench["Bpmn.Benchmarks<br/>tests/Bpmn.Benchmarks<br/>References Bpmn"]:::test
    e2e["Bpmn.E2E.Tests<br/>tests/Bpmn.E2E.Tests<br/>Demo build dependency only"]:::test
    toolstests["Bpmn.Tools.Tests<br/>tests/Bpmn.Tools.Tests"]:::test
