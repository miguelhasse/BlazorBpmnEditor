%% Editing command spine
%% History stores immutable snapshots, not inverse commands; refused edits change neither model nor history.
%% Canvas drag may apply optimistically; Blazor validates the resulting edit request against the model of record.
%% No document revision / incremental canvas patch contract: loadDocument redraws; panel Revision is local UI state.
flowchart TB
    gesture["User gesture<br/>Canvas · panel · keyboard"]:::cs
    command["BpmnEditCommand<br/>Typed intent / EditRequest"]:::cs
    history["BpmnEditHistory.Apply<br/>Undo + redo snapshot stacks"]:::cs
    apply["BpmnDocumentEditor.Apply<br/>Pure validation + edit"]:::cs
    doc["New BpmnDocument<br/>Semantic + BPMNDI changes<br/>Record old snapshot on success"]:::data
    publish["Core: BpmnEditorSession<br/>Publish immutable state<br/>OnDocumentChanged"]:::cs
    canvas["BpmnCanvas<br/>JS loadDocument → renderDocument<br/>JointJS graph redraw"]:::js
    panel["Standard / Fluent property panel<br/>BpmnPropertyPanelBase<br/>Cached groups + entry contexts<br/>Revision resets refused edits"]:::cs
    undo["Undo / Redo<br/>Restore exact snapshots"]:::cs
    gesture --> command
    command --> history
    history --> apply
    apply --> doc
    doc --> publish
    publish --> canvas
    publish --> panel
    history --> undo
    undo --> publish
    classDef cs fill:#a5d8ff,stroke:#343a40,color:#212529
    classDef js fill:#ffec99,stroke:#343a40,color:#212529
    classDef data fill:#b2f2bb,stroke:#343a40,color:#212529
    classDef test fill:#e9ecef,stroke:#343a40,color:#212529
