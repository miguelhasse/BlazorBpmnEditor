%% Editor composition and extension seams
%% Both supplied kits depend on Core; neither depends on the other.
%% Editor components require session/state. Canvas widgets additionally require a surface.
flowchart TB
    host["Host application<br/>Standard / Fluent / third-party kit<br/>Own layout and composition slots"]:::cs
    scope["BpmnEditorScope (Core)<br/>One BpmnEditorSession<br/>Cascades session + immutable state"]:::cs
    parts["BpmnPart<br/>Instance ChildContent → host override<br/>→ kit defaults → Core defaults"]:::cs
    bases["BpmnEditorComponentBase<br/>Toolbar / properties / validation bases<br/>Require scope; shared commands"]:::cs
    adapter["BpmnEditorCanvas<br/>One canvas attachment<br/>Automatic widget parts + extra overlays"]:::cs
    canvas["BpmnCanvas (Core)<br/>Sole canvas interop owner<br/>Cascades BpmnCanvasSurface"]:::cs
    widgets["BpmnCanvasWidgetBase<br/>Context menu · label editor<br/>Contextual actions · accessible tree<br/>Require scope and canvas surface"]:::cs
    entries["BpmnPropertyEditorRegistry<br/>Host + kit entry renderers<br/>Guarded BpmnPropertyEntryContext"]:::data
    host --> scope
    scope --> parts
    scope --> adapter
    parts --> bases
    adapter --> canvas
    canvas --> widgets
    bases --> entries
    classDef cs fill:#a5d8ff,stroke:#343a40,color:#212529
    classDef data fill:#b2f2bb,stroke:#343a40,color:#212529
