%% Managed render path
%% Immutable document identity invalidates derived caches. Only changed state is published.
%% Filtering applies to state-only cascades, not local events or other parameter changes.
flowchart TB
    input["Session command / canvas event<br/>Edit · selection · viewport<br/>Configuration / registry changes"]:::cs
    cache["BpmnEditorSession caches<br/>Descriptions · graph · diagrams<br/>Callables · menus · expansions"]:::data
    state["RefreshState<br/>Preserve unchanged slices<br/>Reuse equivalent BpmnEditorState"]:::cs
    event["Changed state only<br/>StateChanged event<br/>BpmnEditorScope rerender"]:::cs
    gate["BpmnStateRenderGate<br/>Detect state-only cascade update<br/>Culture + other parameters bypass gate"]:::cs
    predicate["ShouldRenderOnStateChange<br/>Default: true<br/>Presentation bases compare read slices"]:::cs
    render["Render affected components<br/>Cached property groups / contexts<br/>Validation rows / part resolution"]:::cs
    local["Local events / explicit render<br/>Async completion / changed parameters<br/>Normal Blazor rendering"]:::cs
    input --> cache
    cache --> state
    state --> event
    event --> gate
    gate --> predicate
    predicate --> render
    local --> render
    classDef cs fill:#a5d8ff,stroke:#343a40,color:#212529
    classDef data fill:#b2f2bb,stroke:#343a40,color:#212529
