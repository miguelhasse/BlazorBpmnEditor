<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <EnableXlfLocalization>true</EnableXlfLocalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\templates\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bpmn\Hasseware.AspNetCore.Components.Bpmn.csproj" />
    <ProjectReference Include="..\..\src\BpmnEditor\Hasseware.AspNetCore.Components.BpmnEditor.csproj" />
    <ProjectReference Include="..\..\src\FluentUI.BpmnEditor\Hasseware.FluentUI.AspNetCore.Components.BpmnEditor.csproj" />
    <ProjectReference Include="..\..\src\Bpmn.Feel\Hasseware.AspNetCore.Components.Bpmn.Feel.csproj" />
    <ProjectReference Include="..\..\src\Bpmn.WebMcp\Hasseware.AspNetCore.Components.Bpmn.WebMcp.csproj" />
    <ProjectReference Include="..\..\src\Bpmn.Storage.ServerSentEvents.Client\Hasseware.AspNetCore.Components.Bpmn.Storage.ServerSentEvents.Client.csproj" />
  </ItemGroup>

</Project>
