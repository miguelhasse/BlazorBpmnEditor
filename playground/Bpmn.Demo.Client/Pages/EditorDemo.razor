@page "/editor"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Hasseware.AspNetCore.Components.Bpmn.Serialization
@using Hasseware.AspNetCore.Components.Bpmn.WebMcp
@using FluentIcons = Microsoft.FluentUI.AspNetCore.Components.Icons

<PageTitle>@Localizer["Editor.Title"]</PageTitle>

<div class="demo-shell">
    <div class="demo-controls demo-editor-controls">
        <div data-controls="actions">
            <FluentButton @ref="_filesButton" Id="@_filesButtonId" Type="ButtonType.Button"
                          Title="@Localizer["Editor.Files"]"
                          IconStart="@(new FluentIcons.Regular.Size20.FolderOpen())"
                          IconEnd="@(new FluentIcons.Regular.Size16.ChevronDown())"
                          aria-haspopup="dialog" aria-controls="@($"{_filesButtonId}-popover")"
                          aria-expanded="@(_filesOpened ? "true" : "false")"
                          OnClick="@ToggleFiles">
                @Localizer["Editor.Files"]
            </FluentButton>
            <FluentButton @ref="_settingsButton" Id="@_settingsButtonId" Type="ButtonType.Button"
                          Title="@Localizer["Editor.Settings"]"
                          IconStart="@(new FluentIcons.Regular.Size20.Settings())"
                          IconEnd="@(new FluentIcons.Regular.Size16.ChevronDown())"
                          aria-haspopup="dialog" aria-controls="@($"{_settingsButtonId}-popover")"
                          aria-expanded="@(_settingsOpened ? "true" : "false")"
                          OnClick="@ToggleSettings">
                @Localizer["Editor.Settings"]
            </FluentButton>
            <FluentSwitch Class="demo-show-properties"
                          role="switch" aria-checked="@(_showProperties ? "true" : "false")"
                          Value="@_showProperties" ValueChanged="@OnShowPropertiesChanged"
                          Label="@Localizer["Editor.Properties"]" />
            <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Subtle"
                          Title="@Localizer["Editor.SimulateExternalChange"]"
                          Class="demo-external-change" Disabled="@(_binding.Key is null)"
                          OnClick="@SimulateExternalChangeAsync">
                @Localizer["Editor.SimulateExternalChange"]
            </FluentButton>
        </div>

        <FluentPopover Id="@($"{_filesButtonId}-popover")" AnchorId="@_filesButtonId"
                       @bind-Opened="@_filesOpened" Class="demo-control-popover"
                       @onkeydown="@(args => OnPopoverKeyDown(args, _filesButton))"
                       Width="min(23rem, calc(100vw - 2rem))" Padding="1rem" OffsetVertical="8"
                       role="dialog" aria-label="@Localizer["Editor.Files"]">
            <div data-controls="panel">
                <h2>@Localizer["Editor.Files"]</h2>
                <FluentButton @ref="_openFileButton" Id="@($"{_filesButtonId}-open")" Type="ButtonType.Button"
                              Title="@Localizer["Editor.OpenFile"]"
                              IconStart="@(new FluentIcons.Regular.Size20.FolderOpen())">
                    @Localizer["Editor.OpenFile"]
                </FluentButton>
                <FluentInputFile AnchorId="@($"{_filesButtonId}-open")" Style="display: none"
                                 Accept="@BpmnFileFormats.Accept" Multiple="false"
                                 OnInputFileChange="@OpenFileAsync" />
                <FluentSelect TOption="string"
                              TValue="string"
                              Items="@SampleFiles"
                              OptionText="@(file => file)"
                              OptionValue="@(file => file)"
                              Value="@_selectedSample"
                              ValueChanged="@LoadSampleAsync"
                              Label="@Localizer["SampleDiagram"]" />
                <div data-controls="file-actions">
                    <FluentButton Type="ButtonType.Button" Class="demo-export"
                                  Title="@Localizer["Editor.ExportXml"]"
                                  Disabled="@(_document is null)" OnClick="@ExportXml">
                        @Localizer["Editor.ExportXml"]
                    </FluentButton>
                    <FluentButton Type="ButtonType.Button" Class="demo-export"
                                  Title="@Localizer["Editor.ExportJson"]"
                                  Disabled="@(_document is null)" OnClick="@ExportJson">
                        @Localizer["Editor.ExportJson"]
                    </FluentButton>
                </div>
                <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Primary"
                              Title="@Localizer["Editor.Save"]"
                              IconStart="@(new FluentIcons.Regular.Size20.Save())"
                              Class="demo-save" Disabled="@(!_binding.IsDirty || _readOnly)"
                              OnClick="@SaveAsync">
                    @Localizer["Editor.Save"]
                </FluentButton>
            </div>
        </FluentPopover>

        <FluentPopover Id="@($"{_settingsButtonId}-popover")" AnchorId="@_settingsButtonId"
                       @bind-Opened="@_settingsOpened" Class="demo-control-popover"
                       @onkeydown="@(args => OnPopoverKeyDown(args, _settingsButton))"
                       Width="min(23rem, calc(100vw - 2rem))" Padding="1rem" OffsetVertical="8"
                       role="dialog" aria-label="@Localizer["Editor.Settings"]">
            <div data-controls="panel">
                <h2>@Localizer["Editor.Settings"]</h2>
                <div data-controls="settings-group">
                    <FluentSwitch @ref="_contrastSwitch" Class="demo-high-contrast"
                                  role="switch" aria-checked="@(_highContrast ? "true" : "false")"
                                  Value="@_highContrast" ValueChanged="@OnContrastChanged"
                                  Label="@Localizer["Editor.HighContrast"]" />
                    <FluentSwitch Class="demo-read-only"
                                  role="switch" aria-checked="@(_readOnly ? "true" : "false")"
                                  Value="@_readOnly" ValueChanged="@OnReadOnlyChanged"
                                  Label="@Localizer["Editor.ReadOnly"]" />
                    <FluentSwitch role="switch" aria-checked="@(_snapToGrid ? "true" : "false")"
                                  Value="@_snapToGrid" ValueChanged="@ToggleSnap"
                                  Label="@Localizer["Editor.SnapToGrid"]" />
                </div>
                <div data-controls="settings-group">
                    <FluentSwitch Class="demo-webmcp"
                                  role="switch" aria-checked="@(_webMcp ? "true" : "false")"
                                  Value="@_webMcp" ValueChanged="@OnWebMcpChanged"
                                  Label="@Localizer["Editor.WebMcp"]" />
                    @if (_webMcp)
                    {
                        <FluentSwitch Class="demo-webmcp-edit"
                                      role="switch" aria-checked="@(_webMcpEdit ? "true" : "false")"
                                      Value="@_webMcpEdit" ValueChanged="@OnWebMcpEditChanged"
                                      Label="@Localizer["Editor.WebMcpEdit"]" />
                    }
                    <span class="demo-webmcp-status" role="status">@_webMcpStatus</span>
                </div>
                <div data-controls="settings-group">
                    <FluentSwitch Class="demo-execution"
                                  role="switch" aria-checked="@(_showExecution ? "true" : "false")"
                                  Value="@_showExecution" ValueChanged="@OnExecutionChangedAsync"
                                  Label="@Localizer["Editor.ExecutionState"]" />
                    <FluentSwitch Class="demo-execution-animation"
                                  role="switch" aria-checked="@(_animateTokens ? "true" : "false")"
                                  Value="@_animateTokens" ValueChanged="@OnAnimationChanged"
                                  Label="@Localizer["Editor.AnimateTokens"]" />
                </div>
            </div>
        </FluentPopover>

        <div data-controls="status">
            <span class="demo-status" title="@_status">@_status</span>
            <span class="demo-edit-status" title="@_editStatus">@_editStatus</span>
            <span class="demo-save-status" title="@SaveStatus" role="status">@SaveStatus</span>
        </div>
    </div>

    @if (_path.Count > 1)
    {
        <nav class="demo-breadcrumb" aria-label="@Localizer["Editor.DiagramPath"]">
            @foreach (var (step, index) in _path.Select((step, index) => (step, index)))
            {
                @if (index > 0)
                {
                    <span class="demo-breadcrumb__separator" aria-hidden="true">/</span>
                }

                <button type="button"
                        class="demo-breadcrumb__step"
                        disabled="@(index == _path.Count - 1)"
                        @onclick="@(() => AscendAsync(step.DiagramId))">
                    @step.Label
                </button>
            }
        </nav>
    }

    @if (Plain)
    {
    <BpmnEditor @ref="_plainEditor"
                Class="demo-editor"
                Configuration="@_configuration"
                DocumentBinding="@_binding"
                IsReadOnly="@_readOnly"
                ShowStencil="true"
                ShowPanel="@_showProperties"
                Theming="@_theme"
                ExecutionAnimation="@(_animateTokens ? BpmnExecutionAnimation.Enabled : BpmnExecutionAnimation.Disabled)"
                OnDocumentChanged="@OnDocumentChanged"
                OnSelectionChanged="@OnSelectionChanged"
                OnDiagramNavigated="@OnDiagramNavigated"
                OnImported="@OnImported"
                OnEditRejected="@OnEditRejected"
                OnCanvasInitialized="@OnCanvasInitialized"
                OnDocumentLoaded="@OnDocumentLoadedAsync"
                OnConfigRejected="@OnConfigRejected">
        <ToolbarContent>
            <BpmnToolbar ShowColorPicker="true">
                <BpmnDiagramNavigator />
            </BpmnToolbar>
        </ToolbarContent>
        <PanelContent>
            @*
                The property panel lives in the side slot, which is the one surface that stays put
                while the selection moves. Its width is fixed by the editor's own grid, so a long
                value cannot narrow the canvas under the pointer.
            *@
            <BpmnPropertyPanel />
        </PanelContent>
        <Footer>
            <BpmnValidationPanel Class="demo-validation" />
        </Footer>
        <Dialogs>
            @if (_webMcp)
            {
                <BpmnWebMcp @key="_webMcpEdit" @ref="_webMcpPart" AllowMutations="_webMcpEdit" OnRegistered="OnWebMcpSettled" OnUnavailable="OnWebMcpSettled" />
            }
        </Dialogs>
    </BpmnEditor>
    }
    else
    {
    <FluentBpmnEditor @ref="_fluentEditor"
                Class="demo-editor"
                Configuration="@_configuration"
                DocumentBinding="@_binding"
                IsReadOnly="@_readOnly"
                ShowStencil="true"
                ShowPanel="@_showProperties"
                Theming="@_theme"
                ExecutionAnimation="@(_animateTokens ? BpmnExecutionAnimation.Enabled : BpmnExecutionAnimation.Disabled)"
                OnDocumentChanged="@OnDocumentChanged"
                OnSelectionChanged="@OnSelectionChanged"
                OnDiagramNavigated="@OnDiagramNavigated"
                OnImported="@OnImported"
                OnEditRejected="@OnEditRejected"
                OnCanvasInitialized="@OnCanvasInitialized"
                OnDocumentLoaded="@OnDocumentLoadedAsync"
                OnConfigRejected="@OnConfigRejected">
        <ToolbarContent>
            <FluentBpmnToolbar ShowColorPicker="true">
                <FluentBpmnDiagramNavigator />
            </FluentBpmnToolbar>
        </ToolbarContent>
        <PanelContent>
            @*
                The property panel lives in the side slot, which is the one surface that stays put
                while the selection moves. Its width is fixed by the editor's own grid, so a long
                value cannot narrow the canvas under the pointer.
            *@
            <FluentBpmnPropertyPanel />
        </PanelContent>
        <Footer>
            <FluentBpmnValidationPanel Class="demo-validation" />
        </Footer>
        <Dialogs>
            @if (_webMcp)
            {
                <BpmnWebMcp @key="_webMcpEdit" @ref="_webMcpPart" AllowMutations="_webMcpEdit" OnRegistered="OnWebMcpSettled" OnUnavailable="OnWebMcpSettled" />
            }
        </Dialogs>
    </FluentBpmnEditor>
    }

    @*
        Diagnostics below the diagram rather than beside it, which is where a problems list belongs
        and leaves the editor's side slot for the property panel. A docked side panel would also
        take a third of the canvas permanently to say "No problems found".
    *@
        

    @if (_diagnostics.Count > 0)
    {
        <details class="demo-diagnostics">
            <summary>@Localizer["ImportDiagnostics", _diagnostics.Count]</summary>
            <ul>
                @foreach (var diagnostic in _diagnostics)
                {
                    <li><strong>@Localizer[$"ImportSeverity.{diagnostic.Severity}"]</strong> @diagnostic.Message</li>
                }
            </ul>
        </details>
    }
    @if (_exportedXml is not null)
    {
        <details class="demo-exported" open>
            <summary>@Localizer["Editor.ExportedBpmn", _exportedFormat]</summary>
            <pre class="demo-export-xml"><code>@_exportedXml</code></pre>
        </details>
    }
</div>
