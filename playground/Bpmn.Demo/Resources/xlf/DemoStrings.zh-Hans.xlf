<?xml version="1.0" encoding="utf-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.2" xsi:schemaLocation="urn:oasis:names:tc:xliff:document:1.2 xliff-core-1.2-transitional.xsd">
  <file datatype="xml" source-language="en" target-language="zh-Hans" original="../DemoStrings.resx">
    <body>
      <trans-unit id="Error.Description">
        <source>An error occurred while processing your request.</source>
        <target state="translated">处理您的请求时出错。</target>
        <note />
      </trans-unit>
      <trans-unit id="Error.DevelopmentDetails">
        <source>Swapping to the {0} environment will display more detailed information about the error that occurred.</source>
        <target state="translated">切换到 {0} 环境将显示有关所发生错误的更详细信息。</target>
        <note>{0} is the invariant environment name Development.</note>
      </trans-unit>
      <trans-unit id="Error.DevelopmentMode">
        <source>Development Mode</source>
        <target state="translated">开发模式</target>
        <note />
      </trans-unit>
      <trans-unit id="Error.DevelopmentWarning">
        <source>The {0} environment shouldn't be enabled for deployed applications.</source>
        <target state="translated">不应为已部署的应用程序启用 {0} 环境。</target>
        <note>{0} is the invariant environment name Development.</note>
      </trans-unit>
      <trans-unit id="Error.Heading">
        <source>Error.</source>
        <target state="translated">错误。</target>
        <note />
      </trans-unit>
      <trans-unit id="Error.LocalDebugging">
        <source>For local debugging, enable the {0} environment by setting the {1} environment variable to {0} and restarting the app.</source>
        <target state="translated">如需本地调试，请将 {1} 环境变量设置为 {0} 并重启应用，以启用 {0} 环境。</target>
        <note>{0} is Development; {1} is ASPNETCORE_ENVIRONMENT. Do not translate these argument values.</note>
      </trans-unit>
      <trans-unit id="Error.RequestId">
        <source>Request ID:</source>
        <target state="translated">请求 ID：</target>
        <note />
      </trans-unit>
      <trans-unit id="Error.SensitiveInformation">
        <source>It can result in displaying sensitive information from exceptions to end users.</source>
        <target state="translated">这可能导致向最终用户显示异常中的敏感信息。</target>
        <note />
      </trans-unit>
      <trans-unit id="Error.Title">
        <source>Error</source>
        <target state="translated">错误</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.AboutBlazor">
        <source>About Blazor</source>
        <target state="translated">关于 Blazor</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.Dismiss">
        <source>Dismiss</source>
        <target state="translated">关闭</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.Documentation">
        <source>Documentation and demos</source>
        <target state="translated">文档和演示</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.Reload">
        <source>Reload</source>
        <target state="translated">重新加载</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.Title">
        <source>BPMN Demo</source>
        <target state="translated">BPMN 演示</target>
        <note />
      </trans-unit>
      <trans-unit id="Layout.UnhandledError">
        <source>An unhandled error has occurred.</source>
        <target state="translated">发生了未经处理的错误。</target>
        <note />
      </trans-unit>
      <trans-unit id="NotFound.Description">
        <source>Sorry, the content you are looking for does not exist.</source>
        <target state="translated">抱歉，您查找的内容不存在。</target>
        <note />
      </trans-unit>
      <trans-unit id="NotFound.Title">
        <source>Not Found</source>
        <target state="translated">未找到</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.Failed">
        <source>Failed to rejoin. Please retry or reload the page.</source>
        <target state="translated">重新加入失败。请重试或重新加载页面。</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.Paused">
        <source>The session has been paused by the server.</source>
        <target state="translated">会话已被服务器暂停。</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.Rejoining">
        <source>Rejoining the server...</source>
        <target state="translated">正在重新加入服务器...</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.Resume">
        <source>Resume</source>
        <target state="translated">恢复</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.ResumeFailed">
        <source>Failed to resume the session. Please reload the page.</source>
        <target state="translated">恢复会话失败。请重新加载页面。</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.Retry">
        <source>Retry</source>
        <target state="translated">重试</target>
        <note />
      </trans-unit>
      <trans-unit id="Reconnect.RetryIn">
        <source>Rejoin failed... trying again in {0} seconds.</source>
        <target state="translated">重新加入失败... 将在 {0} 秒后重试。</target>
        <note>{0} is replaced by the live countdown element; preserve the placeholder.</note>
      </trans-unit>
    </body>
  </file>
</xliff>