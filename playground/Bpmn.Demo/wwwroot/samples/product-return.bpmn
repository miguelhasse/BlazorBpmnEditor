      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_pr2_di" bpmnElement="f_pr2">
        <di:waypoint x="330" y="77" />
        <di:waypoint x="405" y="77" />
      </bpmndi:BPMNEdge>
