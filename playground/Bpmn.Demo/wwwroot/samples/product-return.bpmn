        <di:waypoint x="1260" y="557" />
        <di:waypoint x="1280" y="557" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_pr13_di" bpmnElement="f_pr13">
        <di:waypoint x="1380" y="557" />
        <di:waypoint x="1462" y="557" />
      </bpmndi:BPMNEdge>
